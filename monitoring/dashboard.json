      {
         "id": 14,
         "type": "stat",
         "title": "Oldest archive check",
         "description": "Age of the oldest successful archive check across feeds and selected hosts. Daily checks warn after 26 hours and turn red after 48 hours. A successful check may confirm that an archive has not changed.",
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 18,
            "y": 16
         },
         "fieldConfig": {
            "defaults": {
               "unit": "dtdurations",
               "decimals": 0,
               "min": 0,
               "noValue": "No data",
               "color": {
                  "mode": "thresholds"
               },
               "mappings": [],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 93600
                     },
                     {
                        "color": "red",
                        "value": 172800
