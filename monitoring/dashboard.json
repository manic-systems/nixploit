      {
         "id": 9,
         "type": "timeseries",
         "title": "Findings over time",
         "description": "Counts from each completed scan remain in place until a later scan succeeds. Use the status and age panels to detect failed or stale collection.",
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "gridPos": {
            "h": 8,
            "w": 16,
            "x": 0,
            "y": 8
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short",
               "min": 0,
               "decimals": 0,
               "color": {
                  "mode": "palette-classic"
               },
               "custom": {
                  "drawStyle": "line",
                  "lineInterpolation": "stepAfter",
                  "lineWidth": 2,
                  "fillOpacity": 10,
                  "showPoints": "never",
                  "spanNulls": false,
                  "stacking": {
                     "mode": "none",
                     "group": "A"
                  }
               }
            },
            "overrides": [
               {
                  "matcher": {
                     "id": "byName",
                     "options": "affected"
                  },
                  "properties": [
                     {
                        "id": "color",
                        "value": {
                           "mode": "fixed",
                           "fixedColor": "red"
                        }
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "unknown"
                  },
                  "properties": [
                     {
                        "id": "color",
                        "value": {
                           "mode": "fixed",
                           "fixedColor": "orange"
                        }
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "suppressed"
                  },
                  "properties": [
                     {
                        "id": "color",
                        "value": {
                           "mode": "fixed",
                           "fixedColor": "blue"
                        }
                     }
                  ]
               }
            ]
         },
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom",
               "showLegend": true
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "targets": [
            {
               "refId": "A",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "editorMode": "code",
               "expr": "sum by (bucket) (nixploit_findings{instance=~\"${instance:regex}\"})",
               "instant": false,
               "range": true,
               "format": "time_series",
               "legendFormat": "{{bucket}}"
            }
         ]
      },
      {
         "id": 10,
         "type": "bargauge",
         "title": "Affected by severity",
         "description": "Unscored findings remain visible as a separate severity. Counts include each affected package, version and CVE per host.",
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "gridPos": {
