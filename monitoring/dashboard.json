      {
         "id": 15,
         "type": "table",
         "title": "Findings",
         "description": "The Table bucket selector filters this table only. Findings with no score are included. Click a CVE to open its NVD record. Saved rows can outlive a failed scan, so check the status and age panels above.",
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "gridPos": {
            "h": 12,
            "w": 24,
            "x": 0,
            "y": 20
         },
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "align": "auto",
                  "cellOptions": {
                     "type": "auto"
                  },
                  "filterable": true
               },
               "noValue": ""
            },
            "overrides": [
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Vulnerability"
                  },
                  "properties": [
                     {
                        "id": "links",
                        "value": [
                           {
                              "title": "Open OSV record",
                              "url": "https://osv.dev/vulnerability/${__value.raw}",
                              "targetBlank": true
                           },
                           {
                              "title": "Open CVE record",
                              "url": "https://www.cve.org/CVERecord?id=${__value.raw}",
                              "targetBlank": true
                           }
                        ]
                     },
                     {
                        "id": "custom.width",
                        "value": 190
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Severity"
                  },
                  "properties": [
                     {
                        "id": "custom.cellOptions",
                        "value": {
                           "type": "color-text"
                        }
                     },
                     {
                        "id": "mappings",
                        "value": [
                           {
                              "type": "value",
                              "options": {
                                 "critical": {
                                    "color": "dark-red",
                                    "text": "critical"
                                 },
                                 "high": {
                                    "color": "red",
                                    "text": "high"
                                 },
                                 "medium": {
                                    "color": "orange",
                                    "text": "medium"
                                 },
                                 "low": {
                                    "color": "blue",
                                    "text": "low"
                                 },
                                 "none": {
                                    "color": "green",
                                    "text": "none"
                                 },
                                 "unscored": {
                                    "color": "gray",
                                    "text": "unscored"
                                 }
                              }
                           }
                        ]
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Known exploited"
                  },
                  "properties": [
                     {
                        "id": "custom.cellOptions",
                        "value": {
                           "type": "color-text"
                        }
                     },
                     {
                        "id": "mappings",
                        "value": [
                           {
                              "type": "value",
                              "options": {
                                 "true": {
                                    "color": "red",
                                    "text": "Yes"
                                 },
                                 "false": {
                                    "text": "No"
                                 }
                              }
                           }
                        ]
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Score"
                  },
                  "properties": [
                     {
                        "id": "decimals",
                        "value": 1
                     },
                     {
                        "id": "custom.width",
                        "value": 80
                     }
                  ]
               }
            ]
         },
         "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "frameIndex": 0,
            "enablePagination": true,
            "sortBy": [
               {
                  "displayName": "Score",
                  "desc": true
               }
            ]
         },
         "transformations": [
            {
               "id": "merge",
               "options": {}
            },
            {
               "id": "filterFieldsByName",
               "options": {
                  "include": {
                     "names": [
                        "instance",
                        "package",
                        "version",
                        "vulnerability",
                        "severity",
                        "Value #B",
                        "known_exploited",
                        "bucket"
                     ]
                  }
               }
            },
            {
               "id": "organize",
               "options": {
                  "excludeByName": {},
                  "indexByName": {
                     "instance": 0,
                     "package": 1,
                     "version": 2,
                     "vulnerability": 3,
                     "severity": 4,
                     "Value #B": 5,
                     "known_exploited": 6,
                     "bucket": 7
                  },
                  "renameByName": {
                     "instance": "Host",
                     "package": "Package",
                     "version": "Version",
                     "vulnerability": "Vulnerability",
                     "severity": "Severity",
                     "Value #B": "Score",
                     "known_exploited": "Known exploited",
                     "bucket": "Bucket"
                  }
               }
            }
         ],
         "targets": [
            {
               "refId": "A",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "editorMode": "code",
               "expr": "max without () (nixploit_finding_info{instance=~\"${instance:regex}\",bucket=~\"${bucket:regex}\"})",
               "instant": true,
               "range": false,
               "format": "table"
            },
            {
               "refId": "B",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "editorMode": "code",
               "expr": "max without () (nixploit_vulnerability_score{instance=~\"${instance:regex}\",bucket=~\"${bucket:regex}\"})",
               "instant": true,
               "range": false,
               "format": "table"
            }
         ]
      }
   ]
