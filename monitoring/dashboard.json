                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "editorMode": "code",
               "expr": "max(time() - nixploit_last_update_success_timestamp_seconds{instance=~\"${instance:regex}\"})",
               "instant": true,
               "range": false,
               "format": "time_series"
            }
         ]
      },
      {
         "id": 5,
         "type": "stat",
         "title": "Affected",
         "description": "Distinct package, version and CVE findings summed across selected hosts. These findings determine the scanner exit status.",
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 0,
            "y": 4
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short",
               "decimals": 0,
               "min": 0,
               "noValue": "No data",
               "color": {
                  "mode": "thresholds"
               },
               "mappings": [],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "red",
                        "value": 1
                     }
                  ]
               }
            },
            "overrides": []
         },
         "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ],
               "fields": "",
               "values": false
            },
            "textMode": "value",
            "wideLayout": true
         },
         "targets": [
            {
               "refId": "A",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "editorMode": "code",
               "expr": "sum(nixploit_findings{instance=~\"${instance:regex}\",bucket=\"affected\"})",
               "instant": true,
               "range": false,
               "format": "time_series"
            }
         ]
      },
