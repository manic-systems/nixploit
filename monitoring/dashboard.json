      {
         "id": 8,
         "type": "stat",
         "title": "Affected and known exploited",
         "description": "Affected package, version and CVE findings whose CVEs appear in the known exploited catalog. A CVE can affect more than one package or host.",
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 18,
            "y": 4
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short",
               "decimals": 0,
