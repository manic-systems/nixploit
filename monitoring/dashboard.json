{
   "uid": "nixploit",
   "title": "Nixploit",
   "description": "Nix system vulnerability findings with separate uncertainty and suppression views. Findings remain available after failures. Check scan and feed freshness before interpreting saved results.",
   "tags": [
      "nix",
      "security",
      "nixploit"
   ],
   "timezone": "browser",
   "schemaVersion": 39,
   "version": 1,
   "editable": true,
   "refresh": "1m",
   "time": {
      "from": "now-7d",
      "to": "now"
   },
   "timepicker": {},
   "templating": {
      "list": [
         {
            "name": "datasource",
            "label": "Prometheus",
            "type": "datasource",
            "query": "prometheus",
            "refresh": 1,
            "regex": "",
            "options": []
         },
         {
            "name": "instance",
            "label": "Host",
            "type": "query",
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "query": {
               "query": "label_values(nixploit_enabled, instance)",
               "refId": "StandardVariableQuery"
            },
            "refresh": 1,
            "sort": 1,
            "multi": true,
            "includeAll": true,
            "allValue": ".*",
            "current": {
               "text": "All",
               "value": "$__all"
            },
            "options": []
         },
         {
            "name": "bucket",
            "label": "Table bucket",
            "type": "custom",
            "query": "affected,unknown,suppressed",
            "multi": true,
            "includeAll": true,
            "allValue": "affected|unknown|suppressed",
            "current": {
               "text": [
                  "affected"
               ],
               "value": [
                  "affected"
               ]
            },
            "options": [
               {
                  "selected": true,
                  "text": "affected",
                  "value": "affected"
               },
               {
                  "selected": false,
                  "text": "unknown",
                  "value": "unknown"
               },
               {
                  "selected": false,
                  "text": "suppressed",
                  "value": "suppressed"
               }
            ]
         }
      ]
   },
   "panels": [
      {
         "id": 1,
         "type": "stat",
         "title": "Latest scan job",
         "description": "Shows failed, missing, running or successful jobs across selected hosts. Saved findings remain visible after an unsuccessful attempt.",
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 0,
            "y": 0
         },
         "fieldConfig": {
            "defaults": {
               "unit": "none",
               "decimals": 0,
               "min": 0,
               "noValue": "No data",
               "color": {
                  "mode": "thresholds"
               },
               "mappings": [
                  {
                     "type": "value",
                     "options": {
                        "0": {
                           "color": "red",
                           "text": "Failed"
                        },
                        "1": {
                           "color": "orange",
                           "text": "No status"
                        },
                        "2": {
                           "color": "blue",
                           "text": "Running"
                        },
                        "3": {
                           "color": "green",
                           "text": "Successful"
                        }
                     }
                  }
               ],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "red",
                        "value": null
                     },
                     {
                        "color": "green",
                        "value": 1
                     }
                  ]
               }
            },
            "overrides": []
         },
         "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ],
               "fields": "",
               "values": false
            },
            "textMode": "value",
            "wideLayout": true
         },
         "targets": [
            {
               "refId": "A",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "editorMode": "code",
               "expr": "min((3 * nixploit_job_success{instance=~\"${instance:regex}\"} + 2 * nixploit_job_running{instance=~\"${instance:regex}\"}) or on (instance, job) nixploit_enabled{instance=~\"${instance:regex}\"})",
               "instant": true,
               "range": false,
               "format": "time_series"
            }
         ]
      },
      {
         "id": 2,
         "type": "stat",
         "title": "Latest feed update",
         "description": "A failure on any selected host turns this panel red. Scans may still use the previous cached feeds.",
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 6,
            "y": 0
         },
         "fieldConfig": {
            "defaults": {
               "unit": "none",
               "decimals": 0,
               "min": 0,
               "noValue": "No data",
               "color": {
                  "mode": "thresholds"
               },
               "mappings": [
                  {
                     "type": "value",
                     "options": {
                        "0": {
                           "color": "red",
                           "text": "Failed"
                        },
                        "1": {
                           "color": "orange",
                           "text": "No status"
                        },
                        "2": {
                           "color": "blue",
                           "text": "Updating"
                        },
                        "3": {
                           "color": "green",
                           "text": "Successful"
                        }
                     }
                  }
               ],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "red",
                        "value": null
                     },
                     {
                        "color": "green",
                        "value": 1
                     }
                  ]
               }
            },
            "overrides": []
         },
         "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ],
               "fields": "",
               "values": false
            },
            "textMode": "value",
            "wideLayout": true
         },
         "targets": [
            {
               "refId": "A",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "editorMode": "code",
               "expr": "min((3 * nixploit_update_success{instance=~\"${instance:regex}\"} + 2 * nixploit_job_running{instance=~\"${instance:regex}\"} * (1 - nixploit_update_success{instance=~\"${instance:regex}\"})) or on (instance, job) nixploit_enabled{instance=~\"${instance:regex}\"})",
               "instant": true,
               "range": false,
               "format": "time_series"
            }
         ]
      },
      {
         "id": 3,
         "type": "stat",
         "title": "Oldest successful scan",
         "description": "Time since the oldest successful scan among selected hosts. Daily scans warn after 26 hours and turn red after 48 hours. Adjust these thresholds if your schedule differs.",
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 12,
            "y": 0
         },
         "fieldConfig": {
            "defaults": {
               "unit": "dtdurations",
               "decimals": 0,
               "min": 0,
               "noValue": "No data",
               "color": {
                  "mode": "thresholds"
               },
               "mappings": [],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 93600
                     },
                     {
                        "color": "red",
                        "value": 172800
                     }
                  ]
               }
            },
            "overrides": []
         },
         "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ],
               "fields": "",
               "values": false
            },
            "textMode": "value",
            "wideLayout": true
         },
         "targets": [
            {
               "refId": "A",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "editorMode": "code",
               "expr": "max(time() - nixploit_last_success_timestamp_seconds{instance=~\"${instance:regex}\"})",
               "instant": true,
               "range": false,
               "format": "time_series"
            }
         ]
      },
      {
         "id": 4,
         "type": "stat",
         "title": "Oldest successful feed update",
         "description": "Time since the oldest successful feed update among selected hosts. Daily updates warn after 26 hours and turn red after 48 hours. Adjust these thresholds if your schedule differs.",
         "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 18,
            "y": 0
         },
         "fieldConfig": {
            "defaults": {
               "unit": "dtdurations",
               "decimals": 0,
               "min": 0,
               "noValue": "No data",
               "color": {
                  "mode": "thresholds"
               },
               "mappings": [],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 93600
                     },
                     {
                        "color": "red",
                        "value": 172800
                     }
                  ]
               }
            },
            "overrides": []
         },
         "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
